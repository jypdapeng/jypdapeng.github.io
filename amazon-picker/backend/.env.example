# 可选：Rainforest API Key，用于稳定获取 Amazon 差评
RAINFOREST_API_KEY=

# 每日采集时间（UTC）
DAILY_COLLECT_HOUR=8
DAILY_COLLECT_MINUTE=0

# 默认监控 ASIN（逗号分隔）
DEFAULT_ASINS=B07Y3PZHD9,B0GVDCX8T2,B0DQDCBF7X,B089YBVBV3

# Reddit 子版块
REDDIT_SUBREDDITS=ACL,kneesurgery,AmazonFinds,BuyItForLife,FulfillmentByAmazon

# Google/Amazon 风向种子词（逗号分隔，系统会自动扩展联想词）
TREND_SEED_KEYWORDS=knee surgery recovery,leg elevation pillow,knee surgery shower cover,walker cup holder,knee extension bolster,acl surgery recovery

# Google Trends 地区
GOOGLE_TRENDS_GEO=US
